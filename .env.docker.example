# ServiceSphere — Docker infrastructure environment variables
# ─────────────────────────────────────────────────────────────
# Copy this file to .env.docker (never commit .env.docker):
#   cp .env.docker.example .env.docker
#
# Then start the stack:
#   npm run infra:up
# or directly:
#   docker compose --env-file .env.docker up -d

# ── MongoDB ───────────────────────────────────────────────────
MONGO_INITDB_ROOT_USERNAME=servicesphere
MONGO_INITDB_ROOT_PASSWORD=change_me_locally

# ── Redis ─────────────────────────────────────────────────────
REDIS_PASSWORD=change_me_locally

# ── Meilisearch ───────────────────────────────────────────────
# Must be at least 16 characters for Meilisearch v1.x in production mode
MEILI_MASTER_KEY=change_me_locally_at_least_16_chars

# ── Application (server service) ──────────────────────────────
MONGO_DB_NAME=jahnavipro
JWT_SECRET=change_me_to_a_long_random_secret_at_least_32_chars
CACHE_DRIVER=redis
SEARCH_DRIVER=meili
