<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Complete Payment - ServiceSphere</title>
    <link href="https://fonts.googleapis.com/css2?family=Sequel+Sans:wght@400;600&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.1.1/css/all.min.css">
    <link rel="stylesheet" href="/styles/payment1.css">
</head>
<body>
    <div class="payment-wrapper">
        <h1 class="page-title">Complete Your Payment</h1>
        
        <div class="payment-container">
            <!-- Payment Details Section -->
            <div class="payment-details">
                <h2 class="section-title"><i class="fas fa-credit-card"></i> Payment Method</h2>
                
                <div class="payment-methods">
                    <div class="payment-method active" id="card-method">
                        <i class="fas fa-credit-card"></i>
                        <div>Card</div>
                    </div>
                    <div class="payment-method" id="paypal-method">
                        <i class="fab fa-paypal"></i>
                        <div>PayPal</div>
                    </div>
                    <div class="payment-method" id="upi-method">
                        <i class="fas fa-mobile-alt"></i>
                        <div>UPI</div>
                    </div>
                </div>
                
                <!-- Card Payment Form -->
                <div id="card-payment-form">
                    <div class="input-group">
                        <label for="cardholder">Cardholder Name</label>
                        <input type="text" id="cardholder" placeholder="As shown on card">
                    </div>
                    
                    <div class="input-group">
                        <label for="cardnumber">Card Number</label>
                        <input type="text" id="cardnumber" placeholder="1234 5678 9012 3456">
                    </div>
                    
                    <div class="card-row">
                        <div class="input-group">
                            <label for="expiry">Expiry Date</label>
                            <input type="text" id="expiry" placeholder="MM/YY">
                        </div>
                        
                        <div class="input-group">
                            <label for="cvv">CVV</label>
                            <input type="text" id="cvv" placeholder="123">
                        </div>
                    </div>
                </div>
                
                <div class="divider"></div>
                
                <h2 class="section-title"><i class="fas fa-user"></i> Billing Information</h2>
                
                <div class="input-group">
                    <label for="email">Email</label>
                    <input type="email" id="email" placeholder="your@email.com">
                </div>
                
                <div class="input-group">
                    <label for="phone">Phone</label>
                    <input type="tel" id="phone" placeholder="Your phone number">
                </div>

                <form action="/payment" method="post">
                    <input type="hidden" name="bookingId" value="<%= bookingId %>">
                    <button id="complete-payment" class="submit-btn" type="submit">Complete Payment</button>
                </form>                
                
                <div class="secure-badge">
                    <i class="fas fa-lock"></i>
                    <span>Secure Payment Processing</span>
                </div>
            </div>
            
            <!-- Order Summary Section -->
            <div class="order-summary">
                <h2 class="section-title"><i class="fas fa-clipboard-list"></i> Order Summary</h2>
                
                <div class="service-details">
                    <div class="service-item">
                        <span>Service:</span>
                        <span id="service-name"><%= serviceType %></span>
                    </div>
                    
                    <div class="service-item">
                        <span>Date:</span>
                        <span id="service-date"><%= date %></span>
                    </div>
                    
                    <div class="service-item">
                        <span>Time:</span>
                        <span id="service-time"><%= time %></span>
                    </div>
                </div>
                
                <div class="helper-details">
                    <div class="helper-avatar">
                        <i class="fas fa-user"></i>
                    </div>
                    <div>
                        <strong id="helper-name"><%= helperName %></strong>
                        <div>Service Provider</div>
                    </div>
                </div>
                
                    <div class="price-breakdown">
                        <div class="price-row">
                            <span>Service Fee</span>
                            <span id="service-fee">₹<%= price %></span>
                        </div>
                        
                        <div class="price-row">
                            <span>Platform Fee</span>
                            <span id="platform-fee">₹<%= (price * 0.1).toFixed(2) %></span>
                        </div>
                        
                        <div class="price-row">
                            <span>Tax</span>
                            <span id="tax-amount">₹<%= (price * 0.1).toFixed(2) %></span>
                        </div>
                        
                        <div class="total-row">
                            <span>Total</span>
                            <span id="total-amount">
                                ₹<%= (price + (price * 0.1) + (price * 0.1)).toFixed(2) %>
                            </span>
                        </div>
                    </div>                
                </div>                
            </div>
        </div>
    </div>
    
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const completePaymentBtn = document.getElementById('complete-payment');
            const expiryInput = document.getElementById('expiry');
            
            // Auto-Slash for Expiry Date
            expiryInput.addEventListener('input', function (e) {
                let value = this.value.replace(/\D/g, ""); // Remove non-digit characters
                if (value.length >= 2) {
                    this.value = value.slice(0, 2) + "/" + value.slice(2, 4);
                } else {
                    this.value = value;
                }
            });
    
            completePaymentBtn.addEventListener('click', async function (e) {
                e.preventDefault();
                
                // Get form values
                const cardholder = document.getElementById('cardholder').value.trim();
                const cardnumber = document.getElementById('cardnumber').value.trim();
                const expiry = expiryInput.value.trim();
                const cvv = document.getElementById('cvv').value.trim();
                const email = document.getElementById('email').value.trim();
                const phone = document.getElementById('phone').value.trim();
    
                // Collect all errors
                const errors = [];
    
                // Cardholder Name Validation
                if (!/^[a-zA-Z\s]+$/.test(cardholder)) {
                    errors.push("• Please enter a valid cardholder name (letters and spaces only).");
                }
    
                // Card Number Validation (16 digits, no spaces)
                if (!/^\d{16}$/.test(cardnumber)) {
                    errors.push("• Please enter a valid 16-digit card number.");
                }
    
                // Expiry Date Validation (MM/YY)
                if (!/^(0[1-9]|1[0-2])\/\d{2}$/.test(expiry)) {
                    errors.push("• Please enter a valid expiry date in MM/YY format.");
                } else {
                    // Check if the card is expired
                    const [month, year] = expiry.split('/');
                    const expiryDate = new Date(`20${year}-${month}-01`);
                    const currentDate = new Date();
                    currentDate.setDate(1); // Set to the first of the month for comparison
                    if (expiryDate < currentDate) {
                        errors.push("• Your card has expired. Please use a different card.");
                    }
                }
    
                // CVV Validation (3 digits)
                if (!/^\d{3}$/.test(cvv)) {
                    errors.push("• Please enter a valid 3-digit CVV.");
                }
    
                // Email Validation
                if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
                    errors.push("• Please enter a valid email address.");
                }
    
                // Phone Number Validation (10 digits)
                if (!/^\d{10}$/.test(phone)) {
                    errors.push("• Please enter a valid 10-digit phone number.");
                }
    
                // Show all errors in one alert
                if (errors.length > 0) {
                    alert(errors.join("\n"));
                    return;
                }
    
                // Proceed with payment if no errors
                try {
                    const bookingId = "<%= bookingId %>";
                    const response = await fetch("/payment", {
                        method: "POST",
                        headers: {
                            "Content-Type": "application/json"
                        },
                        body: JSON.stringify({ bookingId })
                    });
    
                    if (response.ok) {
                        window.location.href = `/review?bookingId=${bookingId}`;
                    } else {
                        alert("Payment failed. Please try again.");
                    }
                } catch (error) {
                    console.error("Payment processing error:", error);
                    alert("An error occurred while processing the payment.");
                }
            });
        });
    </script>          
</body>
</html>