# MongoDB connection string
MONGO_URI=mongodb://localhost:27017/servicesphere

# Express server port
PORT=5000

# Allowed client origin(s) — comma-separated for multiple
CLIENT_URL=http://localhost:5173

# JWT — use a long random string in production
JWT_SECRET=change_me_in_production
JWT_EXPIRY=7d

# Cookie-signing secret (kept for reference; sessions removed)
SESSION_SECRET=change_me

# Environment: development | production | test
NODE_ENV=development

# ── Redis (Phase 2) ──────────────────────────────────────────
# REDIS_PASSWORD must match the value in .env.docker
REDIS_URL=redis://:change_me_locally@localhost:6379

# ── Meilisearch (Phase 2) ────────────────────────────────────
MEILI_HOST=http://localhost:7700
MEILI_MASTER_KEY=change_me_locally_at_least_16_chars

# ── Feature flags ────────────────────────────────────────────
# CACHE_DRIVER: 'redis' | 'memory' (default: memory — uses node-cache, no Redis needed)
CACHE_DRIVER=memory
# SEARCH_DRIVER: 'meili' | 'mongo' (default: mongo — uses regex queries, no Meilisearch needed)
SEARCH_DRIVER=mongo
